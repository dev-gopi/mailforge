{
  "name": "@mailforge/themes",
  "version": "0.1.0",
  "description": "Theme presets, design tokens, and resolution utilities for MailForge",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "sideEffects": false,
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
