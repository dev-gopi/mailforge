{
  "name": "@mailforge/templates",
  "version": "0.1.0",
  "description": "Built-in transactional email templates for MailForge",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailforge/core": "workspace:*",
    "zod": "^4.6.6"
  },
  "sideEffects": false,
  "license": "MIT"
}
