{
    "name": "@mailforge/renderer-mjml",
    "version": "0.1.0",
    "description": "Email-safe MJML rendering and plain-text output for MailForge",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@mailforge/core": "workspace:*",
        "html-to-text": "^10.0.1",
        "juice": "^12.2.0",
        "mjml": "^5.4.1",
        "sanitize-html": "^2.18.0"
    },
    "sideEffects": false,
    "devDependencies": {
        "@types/html-to-text": "^9.0.4",
        "@types/mjml": "^5.0.0",
        "@types/node": "^26.6.5",
        "@types/sanitize-html": "^2.16.2"
    },
    "license": "MIT"
}
